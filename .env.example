# BoilerMind runtime configuration

# Crossref recommends supplying a contact email
# when using its REST API.
BOILERMIND_CROSSREF_MAILTO=

# Network request timeout in seconds.
BOILERMIND_WEB_TIMEOUT=15

# Qwen is used only for hypothesis generation and ambiguity fallback.
# Put real values in ignored .env.local, never commit them.
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
BOILERMIND_QWEN_MODEL=qwen3.7-plus
BOILERMIND_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BOILERMIND_QWEN_TIMEOUT=240
BOILERMIND_QWEN_MAX_TOKENS=4096
